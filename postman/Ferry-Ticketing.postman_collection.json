    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('booking_no', pm.response.json().data.booking_no);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule_id\": \"{{schedule_id}}\",\n  \"items\": [\n    {\n      \"ticket_type_id\": \"{{ticket_type_id}}\",\n      \"quantity\": 2,\n      \"unit_price\": 120\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings/draft",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings",
                "draft"
              ]
            }
          }
        },
        {
          "name": "Update Booking",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_name\": \"Postman User\",\n  \"contact_phone\": \"0812345678\",\n  \"contact_email\": \"{{contact_email}}\",\n  \"passengers\": [\n    { \"full_name\": \"Passenger 1\", \"passenger_type\": \"adult\" },\n    { \"full_name\": \"Passenger 2\", \"passenger_type\": \"adult\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_no}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{booking_no}}"
              ]
            }
          }
        },
        {
          "name": "Get Booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_no}}?contact_email={{contact_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{booking_no}}"
              ],
              "query": [
                {
                  "key": "contact_email",
                  "value": "{{contact_email}}"
                }
              ]
            }
          }
        },
        {
          "name": "Expire Draft Bookings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-internal-api-key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookings/jobs/expire-stale",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings",
                "jobs",
                "expire-stale"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "event": [
