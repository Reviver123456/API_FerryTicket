        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/payments/{{payment_ref}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
