    {
      "name": "Schedules",
      "item": [
        {
          "name": "List Schedules",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "if (data.length > 0) pm.environment.set('schedule_id', data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schedules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "schedules"
              ]
            }
          }
        },
        {
          "name": "Get Schedule By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
