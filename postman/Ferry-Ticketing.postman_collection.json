          "name": "Payment Webhook Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-webhook-secret",
                "value": "{{webhook_secret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_ref\": \"{{payment_ref}}\",\n  \"status\": \"success\",\n  \"transaction_id\": \"TXN-0001\",\n  \"amount\": 240\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments/webhook/callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "webhook",
                "callback"
              ]
            }
          }
        }
      ]
